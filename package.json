{
  "name": "naosa",
  "version": "1.0.0",
  "description": "PWA personal para contar el tiempo sin alcohol",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:android": "tsc && CAPACITOR=1 vite build && cap sync android",
    "apk": "npm run build:android && cd android && ./gradlew assembleRelease"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/cli": "8.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3"
  }
}
